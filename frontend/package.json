{
  "name": "chaoxing-assistant",
  "version": "1.0.0",
  "private": true,
  "description": "Chaoxing Assistant frontend built with Vue, Vite, and Electron IPC adapters.",
  "scripts": {
    "dev": "vite",
    "dev:electron": "vite --mode electron",
    "build:web": "vite build",
    "build": "vite build && electron-builder",
    "preview": "vite preview",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit && vue-tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@vueuse/core": "^10.7.0",
    "pinia": "^2.1.0",
    "vue": "^3.4.0",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "typescript": "^5.3.0",
    "vite": "^5.4.21",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0",
    "vue-tsc": "^2.2.0",
    "vitest": "^1.6.0"
  },
  "main": "dist-electron/main.js"
}
